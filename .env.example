# Safe local template. Copy to .env and replace every secret placeholder locally.
# Use NODE_ENV=test only for an isolated test database; never reuse production data.
NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/pushtidham?replicaSet=rs0
JWT_ACCESS_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-different-random-secret-at-least-32-characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:3000
COOKIE_SAME_SITE=lax
TRUST_PROXY_HOPS=0
ADMIN_SEED_NAME=
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=

# Stripe sandbox/test mode. Never place live keys in this template or the frontend.
# Keep methods disabled until test-mode methods and webhook delivery are configured.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_API_VERSION=2026-09-30.endive
STRIPE_CHECKOUT_SUCCESS_URL=http://localhost:3000/donation-confirmation?session_id={CHECKOUT_SESSION_ID}
STRIPE_CHECKOUT_CANCEL_URL=http://localhost:3000/checkout?canceled=1
STRIPE_CARD_ENABLED=false
STRIPE_ACH_ENABLED=false
STRIPE_FINANCIAL_CONNECTIONS_ENABLED=false
PAYMENT_STATUS_TOKEN_SECRET=
STRIPE_CARD_FEE_BPS=
STRIPE_CARD_FEE_FIXED_CENTS=
STRIPE_ACH_FEE_BPS=
STRIPE_ACH_FEE_FIXED_CENTS=
STRIPE_ACH_FEE_CAP_CENTS=
STRIPE_ACH_VERIFICATION_CENTS=
STRIPE_ACH_COVER_VERIFICATION_COST=false
STRIPE_RECONCILIATION_MIN_AGE_MINUTES=60
STRIPE_RECONCILIATION_BATCH_SIZE=25
# PayPal sandbox. Create local credentials in the PayPal developer dashboard.
# Keep disabled until the sandbox app, merchant, buyer and webhook are configured.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_WEBHOOK_ID=
PAYPAL_RETURN_URL=http://localhost:3000/donation-confirmation?paypal_order_id={order_id}
PAYPAL_CANCEL_URL=http://localhost:3000/checkout?canceled=1
PAYPAL_ENABLED=false
PAYPAL_VENMO_ENABLED=false
PAYPAL_MERCHANT_ID=
PAYPAL_FEE_BPS=
PAYPAL_FEE_FIXED_CENTS=
PAYPAL_RECONCILIATION_MIN_AGE_MINUTES=60
PAYPAL_RECONCILIATION_BATCH_SIZE=25
